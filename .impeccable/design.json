  "narrative": {
    "northStar": "暗房里的液态镜片",
    "overview": "界面像一枚悬浮在暗房中的光学镜片：冷静、克制、透光，但不会牺牲专业工具所需的清晰度和密度。液态玻璃是信息层级和交互状态，不是覆盖所有内容的装饰。",
    "keyCharacteristics": [
      "深色暗房底色与冷蓝光学强调色。",
      "不对称高光、柔和折射和清晰边缘共同定义玻璃。",
      "品牌首屏宽松，专业工作台紧凑。",
      "动效用于解释进入、展开和处理中状态，并尊重减少动态效果设置。"
    ],
    "rules": [
      {
        "name": "The Rare Blue Rule",
        "body": "光学蓝只标记当前主操作、活动状态或关键数据，不把整个界面染蓝。",
        "section": "colors"
      },
      {
        "name": "The Optical Evidence Rule",
        "body": "玻璃必须同时具备边缘、透射和阴影证据；只有模糊或只有透明度都不算完成的玻璃。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 用真实内容、视频和照片为玻璃提供折射背景。",
      "Do 保持表单显式标签、可见焦点、就近错误和提交状态。",
      "Do 在视频或网络资源不可用时保留完整的静态暗房背景。",
      "Do 在工作台优先保证直方图、曲线、图片与参数的可读性。"
    ],
    "donts": [
      "Don't 把每一段文字都放进独立玻璃卡片。",
      "Don't 使用无边界的低透明表面，让文字与背景互相干扰。",
      "Don't 用装饰动画掩盖分析、导出或登录的真实进度。",
      "Don't 使用 Emoji 充当结构图标，或混用不同描边语言。"
    ]
  }
